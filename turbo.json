{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	},
	"globalEnv": [
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"CORS_ORIGIN",
		"DATABASE_URL",
		"NEXT_PUBLIC_SERVER_URL",
		"NODE_ENV",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"VERCEL_URL",
		"_VARLOCK_ENV_KEY",
		"SETTLEMENT_WORKER_SECRET",
		"SERVER_URL",
		"FLASHSCORE_API_URL",
		"FLASHSCORE_API_KEY",
		"PORT"
	],
	"globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
