# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# The Atlas integration provides MONGODB_URI. An explicit DATABASE_URL overrides it.
# @required=false @type=string(minLength=1)
MONGODB_URI=

# @type=string(minLength=1)
DATABASE_URL=$MONGODB_URI

# Optional base URL for the Flashscore scraper. Defaults to http://127.0.0.1:8000.
# @required=false @type=url
FLASHSCORE_API_URL=

# Optional key used only by the server when calling the Flashscore scraper.
# @required=false @sensitive @type=string
FLASHSCORE_API_KEY=

# Required for production settlement daemon; optional for local development.
# @required=false @sensitive @type=string(minLength=32)
SETTLEMENT_WORKER_SECRET=

# Optional authenticated daily Vercel settlement fallback.
# @required=false @sensitive @type=string(minLength=32)
CRON_SECRET=
